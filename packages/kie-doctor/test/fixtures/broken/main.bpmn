<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_defsBroken"
                   targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:process id="main" name="main" drools:packageName="com.example" isExecutable="true" processType="Public">
    <bpmn2:startEvent id="start" name="Start">
      <bpmn2:outgoing>f1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:businessRuleTask id="ruleTask" name="Score" drools:ruleFlowGroup="nope" implementation="http://www.jboss.org/drools/rule">
      <bpmn2:incoming>f1</bpmn2:incoming>
      <bpmn2:outgoing>f2</bpmn2:outgoing>
    </bpmn2:businessRuleTask>
    <bpmn2:businessRuleTask id="dmnTask" name="Decide" implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:incoming>f2</bpmn2:incoming>
      <bpmn2:outgoing>f3</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_ioSpec1">
        <bpmn2:dataInput id="_dmnTask_fileNameInputX" name="fileName"/>
        <bpmn2:dataInput id="_dmnTask_namespaceInputX" name="namespace"/>
        <bpmn2:inputSet id="_inputSet1">
          <bpmn2:dataInputRefs>_dmnTask_fileNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_dmnTask_namespaceInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_outputSet1"/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_dia1">
        <bpmn2:targetRef>_dmnTask_fileNameInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_a1">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[missing.dmn]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_dmnTask_fileNameInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_dia2">
        <bpmn2:targetRef>_dmnTask_namespaceInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_a2">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[https://kie.org/dmn/_DOES_NOT_EXIST]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_dmnTask_namespaceInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:businessRuleTask>
    <bpmn2:callActivity id="call" name="Call Missing" calledElement="missing-proc">
      <bpmn2:incoming>f3</bpmn2:incoming>
      <bpmn2:outgoing>f4</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:endEvent id="end" name="End">
      <bpmn2:incoming>f4</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="f1" sourceRef="start" targetRef="ruleTask"/>
    <bpmn2:sequenceFlow id="f2" sourceRef="ruleTask" targetRef="dmnTask"/>
    <bpmn2:sequenceFlow id="f3" sourceRef="dmnTask" targetRef="call"/>
    <bpmn2:sequenceFlow id="f4" sourceRef="call" targetRef="end"/>
  </bpmn2:process>
</bpmn2:definitions>
