{
  "name": "@kie-agent-tools/kogito-trace",
  "version": "0.1.0",
  "description": "CLI for tracing Kogito process instance execution via the Data Index GraphQL API",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kogito-trace": "bin/kogito-trace.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/cli.cjs --log-level=warning",
    "pretest": "npm run build",
    "test": "tsx --test test/cli.test.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
